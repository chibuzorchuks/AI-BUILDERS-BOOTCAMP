   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original String:\n",
      "   Artificial Intelligence   \n",
      "\n",
      "Uppercase:\n",
      "   ARTIFICIAL INTELLIGENCE   \n",
      "\n",
      "Lowercase:\n",
      "   artificial intelligence   \n",
      "\n",
      "After Strip:\n",
      "Artificial Intelligence\n",
      "\n",
      "Slicing:\n",
      "Artificial\n",
      "\n",
      "Concatenation:\n",
      "Artificial Intelligence is amazing!\n"
     ]
    }
   ],
   "source": [
    "# Given string\n",
    "text = \"   Artificial Intelligence   \"\n",
    "\n",
    "print(\"Original String:\")\n",
    "print(text)\n",
    "\n",
    "# uppercase\n",
    "print(\"\\nUppercase:\")\n",
    "print(text.upper())\n",
    "\n",
    "# lowercase\n",
    "print(\"\\nLowercase:\")\n",
    "print(text.lower())\n",
    "\n",
    "# Remove extra spaces\n",
    "clean_text = text.strip()\n",
    "print(\"\\nAfter Strip:\")\n",
    "print(clean_text)\n",
    "\n",
    "# Slicing (first 10 characters)\n",
    "print(\"\\nSlicing:\")\n",
    "print(clean_text[0:10])\n",
    "\n",
    "# Concatenation\n",
    "new_text = clean_text + \" is amazing!\"\n",
    "print(\"\\nConcatenation:\")\n",
    "print(new_text)"
   ]
  },
